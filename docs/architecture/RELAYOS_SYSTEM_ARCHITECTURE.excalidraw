   "link": null,
   "locked": false,
   "type": "text",
   "id": "txt0788",
   "x": 54,
   "y": 10359.2,
   "width": 2252,
   "height": 14.375,
   "text": "The only time-based invariant the product needs is \"a clock that passed its due date is marked missed\". It is one UPDATE, so it runs wherever the process happens to be awake \u2014 cron, interval, or a request \u2014 rather than requiring a worker tier.",
   "originalText": "The only time-based invariant the product needs is \"a clock that passed its due date is marked missed\". It is one UPDATE, so it runs wherever the process happens to be awake \u2014 cron, interval, or a request \u2014 rather than requiring a worker tier.",
