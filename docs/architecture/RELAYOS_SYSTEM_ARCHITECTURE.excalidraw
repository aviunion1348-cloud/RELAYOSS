   "id": "txt0322",
   "x": 54,
   "y": 4674.48,
   "width": 2292,
   "height": 14.375,
   "text": "socket \u2192 Fastify router \u2192 onRequest hooks (start time, identity) \u2192 handler \u2192 validation \u2192 service/SQL \u2192 response serialisation",
   "originalText": "socket \u2192 Fastify router \u2192 onRequest hooks (start time, identity) \u2192 handler \u2192 validation \u2192 service/SQL \u2192 response serialisation",
   "fontSize": 11.5,
