   "id": "txt0785",
   "x": 1214,
   "y": 10180.740000000002,
   "width": 1092,
   "height": 14.375,
   "text": "There is no queue, no worker, no scheduler table and no retry queue. A job that must be durable would have to be built, not configured.",
   "originalText": "There is no queue, no worker, no scheduler table and no retry queue. A job that must be durable would have to be built, not configured.",
