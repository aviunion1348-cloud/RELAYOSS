   "id": "txt1005",
   "x": 54,
   "y": 13747.2,
   "width": 2292,
   "height": 14.375,
   "text": "The Vercel outage was invisible locally: this workstation's Node can require() an ES module, the platform's could not. Every module-format assertion therefore runs a child process with --no-experimental-require-module, against the real installed packages \u2014 a guard shaped exactly like the failure.",
   "originalText": "The Vercel outage was invisible locally: this workstation's Node can require() an ES module, the platform's could not. Every module-format assertion therefore runs a child process with --no-experimental-require-module, against the real installed packages \u2014 a guard shaped exactly like the failure.",
   "fontSize": 11.5,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
