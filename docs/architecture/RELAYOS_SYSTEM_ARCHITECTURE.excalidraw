   "text": "audit_log (0003_intel.sql): entity_type, entity_id, action, before_json, after_json, actor_id, request_id \u2014 rich history, written by the handlers that need it.",
   "originalText": "audit_log (0003_intel.sql): entity_type, entity_id, action, before_json, after_json, actor_id, request_id \u2014 rich history, written by the handlers that need it.",
