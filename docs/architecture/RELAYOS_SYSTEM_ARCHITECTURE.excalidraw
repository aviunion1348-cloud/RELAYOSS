   "id": "txt0323",
   "x": 54,
   "y": 4689.66,
   "width": 2292,
   "height": 14.375,
   "text": "\u2192 onResponse hooks (log line, RED metrics, change_log row) \u2192 socket. An error at any point unwinds to setErrorHandler,",
   "originalText": "\u2192 onResponse hooks (log line, RED metrics, change_log row) \u2192 socket. An error at any point unwinds to setErrorHandler,",
