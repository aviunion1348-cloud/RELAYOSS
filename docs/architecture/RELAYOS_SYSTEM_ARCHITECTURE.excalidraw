   "id": "txt0787",
   "x": 54,
   "y": 10334.0,
   "width": 2252,
   "height": 18.75,
   "text": "Why this shape",
   "originalText": "Why this shape",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
