   "width": 2292,
   "height": 18.75,
   "text": "Retries: stated honestly",
   "originalText": "Retries: stated honestly",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "angle": 0,
   "strokeColor": "#334155",
