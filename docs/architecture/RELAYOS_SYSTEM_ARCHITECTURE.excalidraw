   "link": null,
   "locked": false,
   "type": "text",
   "id": "txt0927",
   "x": 54,
   "y": 12703.2,
   "width": 2292,
   "height": 14.375,
   "text": "The server retries nothing. The client retries once, and only for 5xx or transport failures (a 4xx is a bug, and retrying it hides the bug). There is no circuit breaker and no bulkhead.",
   "originalText": "The server retries nothing. The client retries once, and only for 5xx or transport failures (a 4xx is a bug, and retrying it hides the bug). There is no circuit breaker and no bulkhead.",
