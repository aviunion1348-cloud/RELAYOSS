   "id": "txt1195",
   "x": 54,
   "y": 16527.76,
   "width": 2292,
   "height": 14.375,
   "text": "RelayOS is a working, well-tested single-service application with a real relational schema and real governance rules. Its weak points are the ones the product deliberately chose: no authentication, no external integrations behind the modelled workflows, and no queue. Its engineering strength is that the failure modes are written down",
   "originalText": "RelayOS is a working, well-tested single-service application with a real relational schema and real governance rules. Its weak points are the ones the product deliberately chose: no authentication, no external integrations behind the modelled workflows, and no queue. Its engineering strength is that the failure modes are written down",
   "fontSize": 11.5,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
