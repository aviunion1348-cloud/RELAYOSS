   "isDeleted": false,
   "boundElements": [],
   "updated": 1762000000000,
   "link": null,
   "locked": false,
   "text": "RelayOS is where a studio keeps its clients, its projects, the tasks inside those\nprojects, and the deadlines that are about to slip — in one place the whole\nteam shares.",
   "originalText": "RelayOS is where a studio keeps its clients, its projects, the tasks inside those\nprojects, and the deadlines that are about to slip — in one place the whole\nteam shares.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25,
   "containerId": null,
   "autoResize": true
  },
