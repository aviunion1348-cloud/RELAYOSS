   "isDeleted": false,
   "boundElements": [],
   "updated": 1762000000000,
   "link": null,
   "locked": false,
   "text": "It is one program, not five. The screens and the server ship together as a single\nthing, so there is nothing to wire up between them.",
   "originalText": "It is one program, not five. The screens and the server ship together as a single\nthing, so there is nothing to wire up between them.",
