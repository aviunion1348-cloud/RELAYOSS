  },
  {
   "id": "2z75l2hkyqjo6",
   "type": "text",
   "x": 82,
   "y": 9741.25,
   "width": 1061.0,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#475569",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "d6ttasf7uyoa4",
   "roundness": null,
   "seed": 10953359,
   "version": 1,
   "versionNonce": 552725218,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1762000000000,
   "link": null,
   "locked": false,
   "text": "An earlier revision fell back to a file database when DATABASE_URL was missing. On a serverless host that file lives in /tmp\nand is deleted with the instance — so the app booted, accepted writes, read them back, and then lost them. It behaved like a\ndatabase right up until the moment it did not. The fix was to refuse to start, and to say which setting is missing.",
   "originalText": "An earlier revision fell back to a file database when DATABASE_URL was missing. On a serverless host that file lives in /tmp\nand is deleted with the instance — so the app booted, accepted writes, read them back, and then lost them. It behaved like a\ndatabase right up until the moment it did not. The fix was to refuse to start, and to say which setting is missing.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25,
   "containerId": null,
   "autoResize": true
  },
