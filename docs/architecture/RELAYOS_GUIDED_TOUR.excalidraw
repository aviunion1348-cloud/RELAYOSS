   "link": null,
   "locked": false,
   "text": "@fastify/static was imported at the top of app.ts. Version 10.1.4 pulled in an ESM-only dependency; on a runtime without\nrequire(esm) that threw while the module was loading — before any route existed. Every request answered boot_failed, and\nnothing could explain why. The fix: pin 10.1.3, import inside the branch that needs it, and test it in a child process.",
   "originalText": "@fastify/static was imported at the top of app.ts. Version 10.1.4 pulled in an ESM-only dependency; on a runtime without\nrequire(esm) that threw while the module was loading — before any route existed. Every request answered boot_failed, and\nnothing could explain why. The fix: pin 10.1.3, import inside the branch that needs it, and test it in a child process.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25,
   "containerId": null,
   "autoResize": true
