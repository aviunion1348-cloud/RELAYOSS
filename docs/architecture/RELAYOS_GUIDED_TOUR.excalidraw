   "roundness": null,
   "seed": 1286007670,
   "version": 1,
   "versionNonce": 982810355,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1762000000000,
   "link": null,
   "locked": false,
   "text": "Every id is prefixed and time-sortable, so a row tells you what it is and roughly when it happened.\nTimestamps are stored as \"YYYY-MM-DD HH:MM:SS\" UTC — deliberately not ISO with a T, because a\nspace sorts before a T and mixing the two silently reorders every comparison.",
   "originalText": "Every id is prefixed and time-sortable, so a row tells you what it is and roughly when it happened.\nTimestamps are stored as \"YYYY-MM-DD HH:MM:SS\" UTC — deliberately not ISO with a T, because a\nspace sorts before a T and mixing the two silently reorders every comparison.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25,
   "containerId": null,
   "autoResize": true
  },
