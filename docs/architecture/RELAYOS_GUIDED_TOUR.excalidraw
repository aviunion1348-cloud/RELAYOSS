   "version": 1,
   "versionNonce": 239591490,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1762000000000,
   "link": null,
   "locked": false,
   "text": "An earlier revision fell back to a file database when DATABASE_URL was missing. On a serverless host that file lives in /tmp\nand dies with the instance — the app booted, accepted writes, read them back, and lost them. The fix was to refuse to start\nand name the missing setting.",
   "originalText": "An earlier revision fell back to a file database when DATABASE_URL was missing. On a serverless host that file lives in /tmp\nand dies with the instance — the app booted, accepted writes, read them back, and lost them. The fix was to refuse to start\nand name the missing setting.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25,
   "containerId": null,
   "autoResize": true
  },
