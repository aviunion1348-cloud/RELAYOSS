  },
  {
   "id": "petxos4om6hsc",
   "type": "text",
   "x": 82,
   "y": 5808.25,
   "width": 844.97,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#475569",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
