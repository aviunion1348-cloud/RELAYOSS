# ---------------------------------------------------------------------------
# Relay OSS · environment
# Copy to .env — never commit real secrets.
#
# Deployed as a Vercel project with two services, these are set once for the
# whole project and are visible to both (api, web). Each service installs its own
# dependencies with devDependencies included (`npm ci --include=dev`) — see
# docs/DEPLOYMENT.md §1.2.2 — so nothing here affects the build toolchain. Nothing
# here is service-specific, and no variable names an internal service URL: the
# browser calls the API same-origin under /api, and the deployment declares no
# service bindings at all (see docs/DEPLOYMENT.md §1.1).
# ---------------------------------------------------------------------------
NODE_ENV=development
# HOST/PORT apply to the long-lived container layout (`npm start`, docker compose)
# and to the `app` image's static server. On Vercel the platform assigns the port;
# setting it there is ignored rather than harmful.
HOST=0.0.0.0
PORT=4000

# Storage. Leave DB_PATH for SQLite (dev). Set DATABASE_URL for Postgres.
DB_PATH=./data/relay.sqlite
# DATABASE_URL=postgres://relay:password@localhost:5432/relay

# ---------------------------------------------------------------- auth ----
# auto     (default) = the shared login if a credential is provisioned, else dev.
# password           = the single shared login. The intended production mode.
# oidc               = verified bearer/session identity from an identity provider.
# dev                = local demonstration identities (refused in production).
#
# 'auto' is what makes one repository work unchanged on a laptop, on a Vercel
# deployment with one shared password, and behind an IdP.
AUTH_MODE=auto
# Required in every mode: signs CSRF tokens and cookie sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-value

# --- The single shared login (AUTH_MODE=password, or auto once provisioned) ---
# Provision the row from these two values:
#   RELAY_LOGIN_USERNAME=… RELAY_ADMIN_PASSWORD_HASH=… npm run db:assign-login
#
# On a serverless deployment they are ALSO read at boot, which is what makes a
# deployment with no database usable: the credential is written before the auth
# mode is resolved, so AUTH_MODE=auto picks `password` instead of refusing `dev`.
# Generate the hash with `npm run set-password`. Never commit a real hash.
# RELAY_LOGIN_USERNAME=lear roadmap 289
# RELAY_ADMIN_PASSWORD_HASH=
#
# The hash is Argon2id, never the password. Generate one with:
#   node scripts/set-password.mjs --print-env
# The script never writes a file; paste the values into your host's environment.
# RELAY_LOGIN_USERNAME=your-shared-username
# RELAY_ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$<salt>$<hash>
# Optional: which user the credential maps to (created if absent).
# RELAY_LOGIN_USER_ID=usr_owner
# RELAY_LOGIN_EMAIL=owner@relay.local
# Required for AUTH_MODE=oidc:
# OIDC_ISSUER=https://your-tenant.eu.auth0.com/
# OIDC_AUDIENCE=https://relay.internal
# OIDC_JWKS_URI=https://your-tenant.eu.auth0.com/.well-known/jwks.json

# Identity used by seed data and by DEMO_AUTO_LOGIN.
DEMO_USER_ID=usr_maya
# Opt-in (dev only): treat an unauthenticated request as the demo user.
# Leave unset so an anonymous request is always rejected.
# DEMO_AUTO_LOGIN=1
# Only for a local demonstration stack that sets NODE_ENV=production.
# ALLOW_DEV_AUTH_IN_PRODUCTION=1

# ---------------------------------------------------------- rate limits ----
# Requests per minute, per client address, per process.
RATE_LIMIT_GLOBAL=1200
RATE_LIMIT_WRITE=240
RATE_LIMIT_AUTH=30

# Comma-separated origins, or * in development.
CORS_ORIGIN=*

LOG_LEVEL=info
# How often the background sweeper marks overdue clocks as missed.
SWEEP_INTERVAL_MS=60000

# Set to 1 to skip auto-migration on boot (production with a migration job).
SKIP_MIGRATE=0

# Vite dev server → API proxy target.
API_ORIGIN=http://127.0.0.1:4000

# ------------------------------------------------------- serverless/Vercel ----
# Postgres pool size per instance. Defaults to 3 when VERCEL is set, else 10.
# Every concurrent function instance holds its own pool, so this must stay small
# unless you are connecting through the provider's pooler.
# DATABASE_POOL_MAX=3

# Authenticates GET /api/cron/sweep. Vercel Cron sends
# `Authorization: Bearer $CRON_SECRET` when this variable is set.
# The endpoint returns 503 when it is unset rather than running unauthenticated.
# CRON_SECRET=<long-random-value>

# How often a lazily-triggered sweep may run, in ms. Cron on Hobby is daily, so
# correctness must not depend on the schedule.
# SWEEP_THROTTLE_MS=60000
